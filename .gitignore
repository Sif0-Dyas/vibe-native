__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
# large artifacts kept local (back them up separately)
oracle/*.npz
models/*.pb
models/*.onnx
*.npz

# --- added during repo setup (protect private data + all model artifacts) ---
# personal music-library DB backup (genre_v2.db.backup, 84 MB) + any local SQLite DBs
*.db*
# insurance: never commit audio if it ever lands inside the project
oracle_tracks/
# Model artifacts stay local EXCEPT the small .json metadata/label files the code
# needs. Binaries (.pb / .onnx / .zip) and anything else in models/ stay ignored.
models/*
!models/.gitkeep
!models/*.json

# --- Phase 4 (app port) ---
*.egg-info/
node_modules/
.eslintcache
.coverage
desktop_backend.log

# --- Phase 6 (packaging) ---
/dist/
/build/
/vendor/

# --- Every Noise genre reference ---
# Derived from a page with no licence whose robots.txt is "Disallow: /".
# Built locally by tools/build_enao.py; never committed or redistributed.
src/vibenative/data/enao.json

# machine-local settings written by the Options tab (holds an absolute DB path)
/settings.ini

# your taxonomy edits (Genres tab -> placement), and reset's backup of them.
# Local like settings.ini: it's your library's opinion, not the project's.
/taxonomy.json
/taxonomy.json.bak

# --- editor / runtime artefacts kept local ---
.claude/
.webview/
desktop_backend.log.prev

# --- electronic-genre crawl (tools/crawl_genres.py) ---
# Derived aggregate of CC0 (Wikidata, MusicBrainz) and CC BY-SA (DBpedia,
# Wikipedia) sources. Rebuildable in ~10 min, so it is kept local rather than
# committed; the file's own "licences" block carries the attribution.
src/vibenative/data/genres_electronic.json
# Cached HTTP responses, so re-runs cost the upstream sources nothing.
.cache/
